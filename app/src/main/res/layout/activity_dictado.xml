<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DICTADO DE DESCRIPCION"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Toque el microfono y hable"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_dictar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DICTAR AHORA"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tv_resultado_dictado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textSize="16sp"
        android:text="El texto aparecera aqui..." />

    <Button
        android:id="@+id/btn_guardar_dictado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Descripcion"
        android:layout_marginTop="24dp" />
</LinearLayout>